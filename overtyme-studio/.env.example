# Copy this file to .env and paste your Comfy API key after the = sign.
# Create a key in your Comfy account under API keys. .env is git-ignored.
COMFY_API_KEY=

# Optional, used by start-studio.sh:
# Folder of your ComfyUI install, so the launcher can start it when it isn't running.
# COMFYUI_DIR=/home/you/ComfyUI
# Make photos on Comfy Router instead of ComfyUI (needs COMFY_API_KEY above).
# STUDIO_ENGINE=router
# Let phones and laptops on your Wi-Fi open the studio (no password; trusted networks only).
# STUDIO_SHARE=1
